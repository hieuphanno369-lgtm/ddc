# Database (Supabase/Postgres) — để trống để chạy mock in-memory
# Supabase: Settings → Database → Connection string (Session pooler)
DATABASE_URL=
# Direct connection (transaction pooler) — bỏ qua nếu không dùng pooler
DIRECT_URL=

# Auth (Google SSO) — để trống để dùng dev-login trên localhost
# BAT BUOC - thieu thi app tra loi 500 (openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chỉ cho phép email thuộc các domain này đăng nhập (cách nhau dấu phẩy)
ALLOWED_EMAIL_DOMAINS=daidung.com.vn

# Role mapping (seed) — email:role, cách nhau dấu phẩy
# role: admin | data-entry | viewer
ROLE_SEED=admin@daidung.com.vn:admin,pm@daidung.com.vn:data-entry

# Ghim "hôm nay" - CHỈ dùng cho test (vitest.config.ts đã tự ghim riêng cho test suite).
# KHÔNG set biến này ở production lẫn dev thật: nó làm đồng hồ đứng yên, mọi cảnh báo phạt
# hợp đồng theo ngày sẽ im lặng không bao giờ bắn. Cần demo dữ liệu seed 09/2026 thì set tay
# tạm thời trong .env cục bộ, không copy giá trị mặc định vào đây.
# DDC_FAKE_TODAY=2026-09-16

# Khoa ma hoa bi mat thong bao (webhook URL, mat khau SMTP) - 32 byte base64: openssl rand -base64 32
# Mat khoa = khong giai ma duoc bi mat da luu (phai nhap lai). Khong commit gia tri that.
NOTIFY_SECRET_KEY=

# Bat buoc de cron ngoai goi duoc /api/cron/*; trong = tat route (503).
CRON_SECRET=
# Ghi de URL XML ty gia Vietcombank (T6). May dev bi chan TLS ra ngoai nen fetch loi la binh
# thuong - dung sua tay trong luc do.
# VCB_RATE_URL=

# Webhook thong bao: mac dinh chi https. Dat 1 de cho http (chi dung noi bo, khong khuyen nghi).
NOTIFY_WEBHOOK_ALLOW_HTTP=
# Danh sach host webhook duoc phep (phay). 'a.com' = dung ten, '.a.com' = moi ten con. Trong = moi host cong khai.
NOTIFY_WEBHOOK_ALLOW_HOSTS=

# E2E (npm run test:e2e) - chay tren cong 3001 + DB ddc_control_tower_b. Mat khau lay tu tai khoan seed, KHONG commit.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PM_EMAIL=
E2E_PM_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=
