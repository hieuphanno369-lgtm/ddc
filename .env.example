# Production: app DUNG KHI KHOI DONG neu thieu/sai bien BAT BUOC (instrumentation.ts + src/lib/env-check.ts).

# BAT BUOC - PostgreSQL 16, dang postgresql://user:pass@host:5432/db
DATABASE_URL=
# BAT BUOC (schema.prisma dung directUrl cho migrate) - khong dung pooler thi dat GIONG DATABASE_URL
DIRECT_URL=

# Auth (Google SSO) — để trống để dùng dev-login trên localhost
# BAT BUOC - toi thieu 32 ky tu (openssl rand -base64 32)
NEXTAUTH_SECRET=
# Dung de dung link dat lai mat khau (quen mat khau qua email, K11/S11) - PHAI la URL that khi
# deploy, khong bao gio lay tu header Host (chong gia mao host).
# BAT BUOC - production phai la https://<ten-mien>, khong co duong dan phia sau
NEXTAUTH_URL=http://localhost:3000
# Tao theo docs/HUONG_DAN_GOOGLE_OAUTH.md; de trong thi an nut Google
# Dien du CA HAI hoac de trong CA HAI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ghim "hôm nay" - CHỈ dùng cho test (vitest.config.ts đã tự ghim riêng cho test suite).
# KHÔNG set biến này ở production lẫn dev thật: nó làm đồng hồ đứng yên, mọi cảnh báo phạt
# hợp đồng theo ngày sẽ im lặng không bao giờ bắn. Cần demo dữ liệu seed 09/2026 thì set tay
# tạm thời trong .env cục bộ, không copy giá trị mặc định vào đây.
# DDC_FAKE_TODAY=2026-09-16

# BAT BUOC - Khoa ma hoa bi mat thong bao (webhook URL, mat khau SMTP) - 32 byte base64: openssl rand -base64 32
# Mat khoa = khong giai ma duoc bi mat da luu (phai nhap lai). Khong commit gia tri that.
NOTIFY_SECRET_KEY=

# BAT BUOC - toi thieu 32 ky tu (openssl rand -base64 32); cron ngoai goi /api/cron/alerts_daily.
CRON_SECRET=

# So tang reverse proxy tin cay phia truoc app (L2, .bangiao/bao-mat.md) - dung de lay dung IP
# khach tu X-Forwarded-For (tinh tu PHAI, khong tin phan tu dau vi client tu gui duoc). Mac dinh 1
# (1 reverse proxy truc tiep, vd Nginx/Caddy noi them IP khach vao CUOI header). Co them 1 tang
# load balancer nua thi dat 2. De trong = coi nhu 1.
# BAT BUOC (R4/R5, vong sua bao mat 2): reverse proxy PHAI tu NOI THEM (append) IP khach vao CUOI
# X-Forwarded-For - vi du Nginx dung "proxy_add_x_forwarded_for", KHONG dung
# "proxy_set_header X-Forwarded-For $remote_addr" (lenh do GHI DE, xoa mat phan client tu gui).
# Chi dat X-Real-Ip ma KHONG xu ly X-Forwarded-For la KHONG DU: app doc X-Forwarded-For truoc,
# client tu gui header gia van thang. Thieu buoc nay thi moi nguoi dung chung khoa 'unknown'
# (co the tu khoa lan nhau) - kiem nhanh sau deploy bang GET /api/health, truong "clientIpResolved"
# phai la true.
# Neu dat: so nguyen >= 1.
TRUSTED_PROXY_HOPS=1

# Webhook thong bao: mac dinh chi https. Dat 1 de cho http (chi dung noi bo, khong khuyen nghi).
NOTIFY_WEBHOOK_ALLOW_HTTP=
# Danh sach host webhook duoc phep (phay). 'a.com' = dung ten, '.a.com' = moi ten con. Trong = moi host cong khai.
NOTIFY_WEBHOOK_ALLOW_HOSTS=

# E2E - cap DB + cong dang ky trong e2e/helpers/env.ts (E2E_TARGETS): B `npm run test:e2e` (3001 + ddc_control_tower_b),
# C `npm run test:e2e` (3003 + ddc_control_tower_c), A `npm run test:e2e:a` (cong rieng 3010 + DB tam ddc_control_tower_e2e_a).
# Mat khau lay tu tai khoan seed, KHONG commit.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PM_EMAIL=
E2E_PM_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=
