# Database (Supabase/Postgres) — để trống để chạy mock in-memory
# Supabase: Settings → Database → Connection string (Session pooler)
DATABASE_URL=
# Direct connection (transaction pooler) — bỏ qua nếu không dùng pooler
DIRECT_URL=

# Auth (Google SSO) — để trống để dùng dev-login trên localhost
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chỉ cho phép email thuộc các domain này đăng nhập (cách nhau dấu phẩy)
ALLOWED_EMAIL_DOMAINS=daidung.com.vn

# Role mapping (seed) — email:role, cách nhau dấu phẩy
# role: admin | data-entry | viewer
ROLE_SEED=admin@daidung.com.vn:admin,pm@daidung.com.vn:data-entry

# Ghim "hôm nay" cho demo/dev để bộ dữ liệu seed 09/2026 còn ý nghĩa.
# Bỏ dòng này ở production để app dùng ngày thật.
DDC_FAKE_TODAY=2026-09-16
